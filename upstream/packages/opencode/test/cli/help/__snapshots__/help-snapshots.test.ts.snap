// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode acp --help 1`] = `
"cc acp

start ACP (Agent Client Protocol) server

옵션:
  -h, --help         show help                                                              [불리언]
  -v, --version      show version number                                                    [불리언]
      --print-logs   print logs to stderr                                                   [불리언]
      --log-level    log level                   [문자열] [선택지: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure         run without external plugins                                           [불리언]
      --port         port to listen on                                            [숫자] [기본값: 0]
      --hostname     hostname to listen on                            [문자열] [기본값: "127.0.0.1"]
      --mdns         enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                            [불리언] [기본값: false]
      --mdns-domain  custom domain name for mDNS service (default: croakcode.local)
                                                                [문자열] [기본값: "croakcode.local"]
      --cors         additional domains to allow for CORS                        [배열] [기본값: []]
      --cwd          working directory
         [문자열] [기본값: "<HOME>"]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode mcp --help 1`] = `
"cc mcp

manage MCP (Model Context Protocol) servers

명령:
  cc mcp add            add an MCP server
  cc mcp list           list MCP servers and their status                                 [별칭: ls]
  cc mcp auth [name]    authenticate with an OAuth-enabled MCP server
  cc mcp logout [name]  remove OAuth credentials for an MCP server
  cc mcp debug <name>   debug OAuth connection for an MCP server

옵션:
  -h, --help        show help                                                               [불리언]
  -v, --version     show version number                                                     [불리언]
      --print-logs  print logs to stderr                                                    [불리언]
      --log-level   log level                    [문자열] [선택지: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure        run without external plugins                                            [불리언]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode resume --help 1`] = `
"cc resume [project]

resume a croakcode session

위치:
  project  path to start croakcode in                                                       [문자열]

옵션:
  -h, --help                          show help                                             [불리언]
  -v, --version                       show version number                                   [불리언]
      --print-logs                    print logs to stderr                                  [불리언]
      --log-level                     log level  [문자열] [선택지: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                          run without external plugins                          [불리언]
      --port                          port to listen on                           [숫자] [기본값: 0]
      --hostname                      hostname to listen on           [문자열] [기본값: "127.0.0.1"]
      --mdns                          enable mDNS service discovery (defaults hostname to 0.0.0.0)
                                                                            [불리언] [기본값: false]
      --mdns-domain                   custom domain name for mDNS service (default: croakcode.local)
                                                                [문자열] [기본값: "croakcode.local"]
      --cors                          additional domains to allow for CORS       [배열] [기본값: []]
  -l, --last                          resume the most recently updated session              [불리언]
  -s, --session                       session id to resume                                  [문자열]
      --fork                          fork the session when resuming (use with --last or --session)
                                                                                            [불리언]
  -m, --model                         model to use in the format of provider/model          [문자열]
      --prompt                        prompt to use                                         [문자열]
      --agent                         agent to use                                          [문자열]
      --dangerously-skip-permissions  start with automatic permission approval enabled (dangerous!)
                                                                            [불리언] [기본값: false]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode attach --help 1`] = `
"cc attach <url>

attach to a running croakcode server

위치:
  url  http://localhost:4096                                                         [문자열] [필수]

옵션:
  -h, --help                          show help                                             [불리언]
  -v, --version                       show version number                                   [불리언]
      --print-logs                    print logs to stderr                                  [불리언]
      --log-level                     log level  [문자열] [선택지: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                          run without external plugins                          [불리언]
      --dir                           directory to run in                                   [문자열]
  -c, --continue                      continue the last session                             [불리언]
  -s, --session                       session id to continue                                [문자열]
      --fork                          fork the session when continuing (use with --continue or
                                      --session)                                            [불리언]
  -p, --password                      basic auth password (defaults to CROAKCODE_SERVER_PASSWORD)
                                                                                            [문자열]
  -u, --username                      basic auth username (defaults to CROAKCODE_SERVER_USERNAME or
                                      'croakcode')                                          [문자열]
      --dangerously-skip-permissions  start with automatic permission approval enabled (dangerous!)
                                                                            [불리언] [기본값: false]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode run --help 1`] = `
"cc run [message..]

run croakcode with a message

위치:
  message  message to send                                                       [배열] [기본값: []]

옵션:
  -h, --help                          show help                                             [불리언]
  -v, --version                       show version number                                   [불리언]
      --print-logs                    print logs to stderr                                  [불리언]
      --log-level                     log level  [문자열] [선택지: "DEBUG", "INFO", "WARN", "ERROR"]
      --pure                          run without external plugins                          [불리언]
      --command                       the command to run, use message for args              [문자열]
  -c, --continue                      continue the last session                             [불리언]
  -s, --session                       session id to continue                                [문자열]
      --fork                          fork the session before continuing (requires --continue or
                                      --session)                                            [불리언]
      --share                         share the session                                     [불리언]
  -m, --model                         model to use in the format of provider/model          [문자열]
      --agent                         agent to use                                          [문자열]
      --format                        format: default (formatted) or json (raw JSON events)
                                            [문자열] [선택지: "default", "json"] [기본값: "default"]
  -f, --file                          file(s) to attach to message                            [배열]
      --title                         title for the session (uses truncated prompt if no value
                                      provided)                                             [문자열]
      --attach                        attach to a running croakcode server (e.g.,
                                      http://localhost:4096)                                [문자열]
  -p, --password                      basic auth password (defaults to CROAKCODE_SERVER_PASSWORD)
                                                                                            [문자열]
  -u, --username                      basic auth username (defaults to CROAKCODE_SERVER_USERNAME or
                                      'croakcode')                                          [문자열]
      --dir                           directory to run in, path on remote server if attaching
                                                                                            [문자열]
      --port                          port for the local server (defaults to random port if no value
                                      provided)                                               [숫자]
      --variant                       model variant (provider-specific reasoning effort, e.g., high,
                                      max, minimal)                                         [문자열]
      --thinking                      show thinking blocks                                  [불리언]
      --replay                        replay visible session history on interactive resume
                                                                            [불리언] [기본값: false]
      --replay-limit                  cap visible interactive replay to the newest N messages [숫자]
  -i, --interactive                   run in direct interactive split-footer mode
                                                                            [불리언] [기본값: false]
      --dangerously-skip-permissions  auto-approve permissions that are not explicitly denied
                                      (dangerous!)                          [불리언] [기본값: false]
      --demo                          enable direct interactive demo slash commands; pass one as the
                                      message to run it immediately         [불리언] [기본값: false]"
`;

