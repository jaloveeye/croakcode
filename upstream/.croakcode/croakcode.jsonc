{
  "provider": {
    "litellm-head": {
      // OpenAI-compatible endpoint (LiteLLM proxy). baseURL must be set per environment.
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Head",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}"
      },
      // Which engine and model serve an alias is the gate's business (its model
      // registry); croakcode sends only the alias and a reasoning level, and the
      // gate turns the level into that model's own parameters.
      "models": {
        "croak": {
          "name": "사내 모델",
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" }
          }
        },
        // Older aliases, kept so earlier sessions still open.
        "qwen3.8-27b-nvfp4": { "name": "사내 모델 (이전 설정)" },
        "default": { "name": "사내 모델 (이전 기본)" }
      }
    }
  },
  // The LiteLLM server caches prompt prefixes. Keeping the date and directories
  // out of the system prompt lets a new session's first request hit that cache
  // even on a new day (about 1.5 s instead of 7 s or more for a cold prefill).
  // read_before_write: edit and write change an existing file only after this
  // session read it and it has not changed since (Phase 5 Task 5).
  // read_dedup: re-reading an unchanged file (2KB or more) returns a short
  // notice while the earlier content is still in the conversation (Task 6).
  "experimental": {
    "stable_prompt_prefix": true,
    "read_before_write": true,
    "read_dedup": true,
    // Ask before risky bash forms even when bash is allowed (Task 7).
    "confirm_risky_bash": true,
    // Send only the core tools plus tool_search and tool_call; the rest load on
    // demand. About 2,200 fewer tokens on the first request (Task 8).
    "deferred_tools": true
  },
  // A tool result above these limits is saved to a file and the model gets the
  // first part plus the file path. The default 50KB (about 13,000 tokens) made
  // the request after a web fetch take 20+ s on a cold prefill.
  "tool_output": { "max_lines": 400, "max_bytes": 16384 },
  // Compaction summaries are checked against the original conversation and
  // corrected before they replace the history. This doubles compaction calls.
  "compaction": { "verify": true },
  // Short default agent (agent/dev-main.md) in place of build's ~9,000-character
  // system prompt: about 1,500 fewer tokens on every first request.
  "default_agent": "dev-main",
  // Upstream's update channels are not ours; croakcode updates from the croak gate.
  "autoupdate": false,
  // Sharing uploads a whole conversation to an outside server past the gate;
  // croakcode refuses it in code as well (src/share/session.ts).
  "share": "disabled",
  "model": "litellm-head/croak",
  "agent": { "build": { "hidden": true } },
  // Claude Code skills (~/.claude/skills) are listed twice per request (system
  // prompt and the skill tool), about 4,100 tokens. croakcode does not use them.
  // Deny all. Allowing a few by name has not been verified yet.
  "permission": { "skill": "deny" },
  "mcp": {},
  "tools": { "github-triage": false, "github-pr-search": false }
}
